<?xml version="1.0" encoding="utf-8"?>
<!--
  An app tile has no box of its own any more. Apps ship their own artwork with their own
  background baked in, so a card behind it only ever showed as a second rectangle around the
  first. The artwork sits on the screen; the focus highlight is what marks the one you are on.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <corners android:radius="16dp" />
</shape>
