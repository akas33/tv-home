<?xml version="1.0" encoding="utf-8"?>
<!--
  An app tile. Translucent, not solid black: with a photo behind the home screen a row of opaque
  black rectangles looked like holes punched in it. Lit from the top edge, like the bento panes,
  so the whole screen shares one surface.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#3D222A52"
        android:endColor="#B00A0D1E" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
    <corners android:radius="16dp" />
</shape>
