<?xml version="1.0" encoding="utf-8"?>
<!--
  The shape the time and weather panes share: the same soft-cornered pill as the buttons along the
  top, just larger, so the whole screen is made of one shape. Colours live in res/values/colors.xml.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/tile_glass_top"
        android:endColor="@color/tile_glass_bottom" />
    <stroke android:width="1dp" android:color="@color/tile_edge" />
    <corners android:radius="26dp" />
</shape>
