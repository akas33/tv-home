<?xml version="1.0" encoding="utf-8"?>
<!--
  The mantra's pane. Focused it gets LIGHTER but stays dark - a pale fill made white text vanish
  into it, which is why landing on it blanked the line out completely. The rim does the work of
  saying it is selected.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#8C3A4468"
                android:endColor="#D9101526" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/tile_glass_top"
                android:endColor="@color/tile_glass_bottom" />
            <stroke android:width="1dp" android:color="@color/tile_edge" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
