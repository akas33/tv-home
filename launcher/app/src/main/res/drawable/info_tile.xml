<?xml version="1.0" encoding="utf-8"?>
<!--
  A small card for the weather and Hindu-date tiles in the top right corner. Two layers: a soft
  dark edge below, then a pane that is lighter at the top than the bottom. That is all "depth" on
  a TV needs - a surface lit from above - and it costs nothing to draw, which matters on a 1 GB TV.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the shadow the card sits on -->
    <item android:top="3dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#4D000000" />
            <corners android:radius="18dp" />
        </shape>
    </item>

    <!-- the card itself -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
