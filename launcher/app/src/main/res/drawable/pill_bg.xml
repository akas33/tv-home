<?xml version="1.0" encoding="utf-8"?>
<!-- Top-bar pill. The focused state was a near-white block, which forced the label to flip to dark
     and looked harsh over the wallpaper. A brighter translucent fill with a clear white edge shows
     focus just as plainly on a TV and lets the text stay white throughout. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3DFFFFFF" />
            <stroke android:width="2dp" android:color="#99FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
