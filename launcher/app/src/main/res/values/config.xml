<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- Screensaver weather (Open-Meteo, free, no account). Latitude/longitude in decimal degrees,
         e.g. 12.97 and 77.59. Leave lat or lon empty to turn weather off. -->
    <string name="weather_lat" translatable="false">12.9716</string>
    <string name="weather_lon" translatable="false">77.5946</string>
    <string name="weather_label" translatable="false">Bengaluru</string>

    <!-- FAMILY BOARD, way 1: a page served by the TV itself. Nothing to install and no account:
         on the home Wi-Fi, open http://<tv ip>:8080 in any phone browser, type a note or pick a
         photo, send. Anyone on your Wi-Fi can post; set a code below if you want one. -->
    <integer name="upload_port">8080</integer>
    <string name="upload_pin" translatable="false"></string>

    <!-- FAMILY BOARD, way 2: email, for sending from outside the house with nothing installed.
         Make a mailbox just for the TV and use an app password, never your real one
         (windows/README.md explains how). Only these senders are accepted; empty means off. -->
    <string name="mail_host" translatable="false">imap.gmail.com</string>
    <string name="mail_user" translatable="false"></string>
    <string name="mail_password" translatable="false"></string>
    <string name="mail_allowed_senders" translatable="false"></string>

    <!-- FAMILY BOARD, way 3: notes AND photos sent to your own Telegram bot from any phone,
         from anywhere. Only the chat IDs listed below are accepted, so nobody else can put
         anything on the TV. Both values are needed; leave the token empty to turn the board off.
         Setup: windows/README.md > "Family board". Keep the token secret, like a password. -->
    <string name="telegram_bot_token" translatable="false"></string>
    <!-- Comma-separated chat IDs allowed to post, e.g. "123456789, 987654321".
         Find them with:  .\windows\tv.ps1 chatid <your bot token>
         Empty means nothing is shown at all (secure default). -->
    <string name="telegram_allowed_chats" translatable="false"></string>

    <!-- A photo this TV has just received holds the whole screen for this many minutes, then photos
         and the clock take turns. Counted from when the TV first saw the photo, so a photo sent
         while the TV was off still gets its moment when the TV comes back on. -->
    <integer name="photo_feature_minutes">10</integer>

    <!-- Old public-topic board (ntfy). Left off: a topic name is only a secret word, and anyone who
         learns it can read and post. Use the Telegram board above instead. -->
    <string name="message_topic" translatable="false"></string>
    <string name="message_server" translatable="false">https://ntfy.sh</string>

    <!-- Bedtime dimming: from dim_start_hour the screensaver fades to black over dim_ramp_minutes and
         stays black until dim_end_hour (24h clock). Set dim_start_hour to -1 to turn it off. -->
    <integer name="dim_start_hour">0</integer>
    <integer name="dim_end_hour">6</integer>
    <integer name="dim_ramp_minutes">45</integer>

    <!-- Screensaver headlines: any RSS or Atom feed URL (https). Leave empty to turn news off. -->
    <string name="news_feed_url" translatable="false">https://www.thehindu.com/news/national/feeder/default.rss</string>

    <!-- Rename inputs in the Inputs menu: "original name=new name". Spaces and case are ignored when
         matching, so "HDMI 1" also matches "HDMI1". Check the real names by opening the Inputs menu. -->
    <string-array name="input_labels">
        <item>HDMI 1=Jio</item>
    </string-array>
</resources>
