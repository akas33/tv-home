<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Nothing secret belongs in this file: it is committed to git.
  Passwords, tokens and the list of people allowed to post go in secrets.xml, which is ignored
  by git. Edit this file, then reinstall (windows: .\windows\tv.ps1 install).

  Package names: on the TV run `pm list packages` (.\windows\tv.ps1 packages).
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <!-- An entry written "input:Name" pins a TV input here, so a set-top box is one press rather
         than three through the Inputs menu. The name must match what the Inputs menu shows. -->
    <string-array name="dock_apps">
        <item>input:Jio</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.droidlogic.droidlivetv</item>
        <item>com.droidlogic.tvinput</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit.
         This TV is a Droidlogic chipset, not MediaTek: confirmed from its own package list. -->
    <string name="live_tv_package" translatable="false">com.droidlogic.droidlivetv</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- Greet in Hindi on the home screen. Set false if your TV has no Devanagari font and the
         greeting shows as boxes. The screensaver keeps English either way. -->
    <bool name="greeting_in_hindi">true</bool>

    <!-- Rename inputs in the Inputs menu: "original name=new name". Spaces and case are ignored when
         matching, so "HDMI 1" also matches "HDMI1". Check the real names by opening the Inputs menu. -->
    <string-array name="input_labels">
        <item>HDMI 1=Jio</item>
    </string-array>

    <!-- Screensaver weather (Open-Meteo, free, no account). Use your CITY centre, not your house:
         these coordinates are committed to git and sent to Open-Meteo on every check.
         Leave lat or lon empty to turn weather off. -->
    <string name="weather_lat" translatable="false">12.9716</string>
    <string name="weather_lon" translatable="false">77.5946</string>
    <string name="weather_label" translatable="false">Bengaluru</string>

    <!-- Screensaver headlines: any RSS or Atom feed URL (https). Leave empty to turn news off. -->
    <string name="news_feed_url" translatable="false">https://www.thehindu.com/news/national/feeder/default.rss</string>

    <!-- FAMILY BOARD, way 1: a page served by the TV itself. Nothing to install and no account:
         on the home Wi-Fi, open http://<tv ip>:8080 in any phone browser, type a note or pick a
         photo, send. The page only accepts connections from your own network, and it has a Clear
         button so anything on screen can be wiped from a phone. Code: upload_pin in secrets.xml. -->
    <integer name="upload_port">8080</integer>

    <!-- The board runs a small always-on service: the upload page, the mail check and the banner
         over other apps. It is the only thing this launcher leaves running. Set to false if you
         would rather have the memory back on a 1 GB TV; the screensaver, clock, weather, news and
         Inputs menu all carry on working without it. -->
    <bool name="board_enabled">true</bool>

    <!-- FAMILY BOARD, way 2: email, for sending from outside the house with nothing installed.
         Mailbox, password and allowed senders live in secrets.xml. -->
    <string name="mail_host" translatable="false">imap.gmail.com</string>

    <!-- FAMILY BOARD, way 3: a private Telegram bot, for family already on Telegram.
         Token and allowed chat IDs live in secrets.xml. -->

    <!-- How long a note or photo stays on the board. Lower it if photos linger too long for
         comfort; the Clear button on the upload page wipes everything at once. -->
    <integer name="board_keep_hours">12</integer>

    <!-- A photo this TV has just received holds the whole screen for this many minutes, then photos
         and the clock take turns. Counted from when the TV first saw the photo, so a photo sent
         while the TV was off still gets its moment when the TV comes back on. -->
    <integer name="photo_feature_minutes">10</integer>

    <!-- Old public-topic board (ntfy), off by default; topic lives in secrets.xml. -->
    <string name="message_server" translatable="false">https://ntfy.sh</string>

    <!-- Bedtime dimming: from dim_start_hour the screensaver fades to black over dim_ramp_minutes
         and stays black until dim_end_hour (24h clock). This only ever affects the screensaver:
         Netflix, Live TV and the home screen are never dimmed.
         Set dim_start_hour to -1 to turn it off completely. -->
    <integer name="dim_start_hour">0</integer>
    <integer name="dim_end_hour">6</integer>
    <integer name="dim_ramp_minutes">45</integer>

    <!-- Still up? If you press any remote button while the screen has dimmed, the screensaver
         leaves dimming off for this many minutes, so it stays bright while you are watching.
         Set to 0 to always dim. -->
    <integer name="dim_bypass_minutes">120</integer>
</resources>
