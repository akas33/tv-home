<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- Screensaver weather (Open-Meteo, free, no account). Latitude/longitude in decimal degrees,
         e.g. 12.97 and 77.59. Leave lat or lon empty to turn weather off. -->
    <string name="weather_lat" translatable="false"></string>
    <string name="weather_lon" translatable="false"></string>
    <string name="weather_label" translatable="false"></string>

    <!-- Screensaver family message board, via ntfy (free, no account). Pick a long random topic name
         that only your family knows, e.g. "kitchen-tv-7f3k9q2x": anyone who knows it can post.
         Family then installs the ntfy app (or opens https://ntfy.sh/<topic>) and sends a note;
         it appears on the TV screensaver for 12 hours. Leave the topic empty to turn it off. -->
    <string name="message_topic" translatable="false"></string>
    <string name="message_server" translatable="false">https://ntfy.sh</string>

    <!-- Bedtime dimming: from dim_start_hour the screensaver fades to black over dim_ramp_minutes and
         stays black until dim_end_hour (24h clock). Set dim_start_hour to -1 to turn it off. -->
    <integer name="dim_start_hour">23</integer>
    <integer name="dim_end_hour">6</integer>
    <integer name="dim_ramp_minutes">45</integer>

    <!-- Screensaver headlines: any RSS or Atom feed URL (https). Leave empty to turn news off. -->
    <string name="news_feed_url" translatable="false"></string>
</resources>
