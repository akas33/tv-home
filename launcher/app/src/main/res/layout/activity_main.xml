<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="54sp"
        android:fontFamily="@font/space_grotesk"
        android:fontVariationSettings="'wght' 400"
        android:letterSpacing="-0.03"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="#D9FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="@font/space_grotesk"
                    android:fontVariationSettings="'wght' 500" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="54sp"
                        android:fontFamily="@font/space_grotesk"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#D9FFFFFF"
                        android:textSize="18sp"
                        android:fontFamily="@font/space_grotesk"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.02"
                        android:includeFontPadding="false" />

                </LinearLayout>

                <!-- The date gets its own line now. Weather and the Hindu date moved to their own
                     tiles in the top right corner, so nothing is crowded together any more. -->
                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/space_grotesk"
                    android:fontVariationSettings="'wght' 500" />

                <!-- The line of the day. Press OK to play the song set in config.xml. No custom
                     font: Space Grotesk has no Devanagari, so this uses the TV's own Hindi font. -->
                <TextView
                    android:id="@+id/quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="9dp"
                    android:background="@drawable/quote_bg"
                    android:textColor="#E9C46A"
                    android:textSize="17sp"
                    android:singleLine="true"
                    android:nextFocusDown="@+id/grid"
                    android:nextFocusUp="@+id/btnInputs"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>

            <!-- Right corner: weather and air quality in one card, the Hindu date in another.
                 These used to be squeezed onto the end of the date line, where they ran into the
                 buttons above. Each is hidden until it has something real to say. -->
            <LinearLayout
                android:id="@+id/cornerTiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_below="@id/topButtons"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="2dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/weatherTile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="164dp"
                    android:background="@drawable/info_tile"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="15dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="24sp"
                        android:fontFamily="@font/space_grotesk"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="-0.02"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/weatherAir"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/space_grotesk"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.02"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/panchangTile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:minWidth="164dp"
                    android:background="@drawable/info_tile"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="15dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/panchangTithi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="19sp"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/panchangMonth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="#B3FFFFFF"
                        android:textSize="14sp"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
