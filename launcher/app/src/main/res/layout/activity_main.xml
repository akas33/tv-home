<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A1024">

    <!-- A soft light that drifts slowly across the background, so the screen is never quite still.
         One view, one translation animation, nothing redrawn: cheap enough for a 1 GB TV. -->
    <View
        android:id="@+id/drift"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- The focus highlight. A direct child of the root, placed BEFORE the content so it is
         drawn behind the tiles: on top it washed the app's artwork out. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="22dp">

        <!-- Greeting on the left, the three buttons on the right. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="20dp"
                android:ellipsize="end"
                android:textColor="@color/greeting"
                android:textSize="20sp"
                android:fontFamily="@font/devanagari"
                android:singleLine="true" />

            

    <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- One pane in the left corner carrying the time and the date, and the weather in the
             right. Two separate tiles for time and date was one box too many. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:id="@+id/leftColumn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

            <LinearLayout
                android:id="@+id/clockTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pane"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="@color/text_bright"
                            android:textSize="46sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="-0.045"
                            android:includeFontPadding="false" />

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="6dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="@color/text_bright"
                            android:textSize="22sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tithi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_soft"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- the dividing line -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@color/tile_edge" />

                <LinearLayout
                    android:id="@+id/dateTile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextClock
                        android:id="@+id/dayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEE"
                        android:format24Hour="EEE"
                        android:textColor="@color/text_bright"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true" />

                    <TextClock
                        android:id="@+id/dayNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:format12Hour="d"
                        android:format24Hour="d"
                        android:textColor="@color/text_bright"
                        android:textSize="40sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <TextClock
                        android:id="@+id/monthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:format12Hour="MMM yyyy"
                        android:format24Hour="MMM yyyy"
                        android:textColor="@color/text_bright"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

                <TextView
                    android:id="@+id/quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp"
                    android:paddingTop="13dp"
                    android:paddingBottom="15dp"
                    android:background="@drawable/quote_bg"
                    android:textColor="@color/accent"
                    android:textSize="18sp"
                    android:singleLine="true"
                    android:nextFocusDown="@+id/grid"
                    android:nextFocusUp="@+id/btnInputs"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Weather, right corner. Two columns side by side in a row that shares its width
                 out, which is what stops air quality landing on top of the conditions: before,
                 both were positioned against the pane's edges and nothing kept them apart. Wider
                 than it was, and the same height as the time pane. -->
            <LinearLayout
                android:id="@+id/weatherTile"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/pane"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/weatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_bright"
                            android:textSize="42sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="-0.045"
                            android:includeFontPadding="false"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/weatherSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_soft"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/airBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical"
                        android:gravity="end"
                        android:visibility="invisible">

                        <TextView
                            android:id="@+id/airNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_bright"
                            android:textSize="34sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="-0.03"
                            android:includeFontPadding="false"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/airWord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/text_soft"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hourly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false" />
            </LinearLayout>
        </RelativeLayout>



        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
