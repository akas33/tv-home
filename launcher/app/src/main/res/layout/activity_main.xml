<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A1024">

    <!-- A soft light that drifts slowly across the background, so the screen is never quite still.
         One view, one translation animation, nothing redrawn: cheap enough for a 1 GB TV. -->
    <View
        android:id="@+id/drift"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- The focus highlight. A direct child of the root, placed BEFORE the content so it is
         drawn behind the tiles: on top it washed the app's artwork out. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="22dp">

        <!-- Greeting on the left, the three buttons on the right. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:textColor="@color/greeting"
                android:textSize="25sp"
                android:fontFamily="@font/devanagari"
                android:singleLine="true" />

            

    <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- One pane in the left corner carrying the time and the date, and the weather in the
             right. Two separate tiles for time and date was one box too many. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:id="@+id/clockTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/pane"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="@color/text_bright"
                            android:textSize="46sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:letterSpacing="-0.045"
                            android:includeFontPadding="false" />

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="6dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="@color/text_bright"
                            android:textSize="17sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.08"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tithi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_faint"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- the dividing line -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="74dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@color/tile_edge" />

                <LinearLayout
                    android:id="@+id/dateTile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextClock
                        android:id="@+id/dayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEE"
                        android:format24Hour="EEE"
                        android:textColor="@color/text_soft"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:letterSpacing="0.16"
                        android:textAllCaps="true"
                        android:singleLine="true" />

                    <TextClock
                        android:id="@+id/dayNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:format12Hour="d"
                        android:format24Hour="d"
                        android:textColor="@color/text_bright"
                        android:textSize="40sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <TextClock
                        android:id="@+id/monthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:format12Hour="MMM yy"
                        android:format24Hour="MMM yy"
                        android:textColor="@color/text_soft"
                        android:textSize="13sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:letterSpacing="0.12"
                        android:textAllCaps="true"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- weather, right corner, half the width it was, with air quality in its own corner -->
            <RelativeLayout
                android:id="@+id/weatherTile"
                android:layout_width="252dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/pane"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="16dp"
                android:paddingBottom="18dp"
                android:visibility="invisible">

                <LinearLayout
                    android:id="@+id/weatherLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weatherPlace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_soft"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:letterSpacing="0.14"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_bright"
                        android:textSize="40sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="-0.045"
                        android:includeFontPadding="false"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- air quality, in the pane's own right corner -->
                <LinearLayout
                    android:id="@+id/airBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="vertical"
                    android:gravity="end"
                    android:visibility="invisible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/aqi"
                        android:textColor="@color/text_soft"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:letterSpacing="0.14" />

                    <TextView
                        android:id="@+id/airNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_bright"
                        android:textSize="30sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="-0.03"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/airWord"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/text_soft"
                        android:textSize="12sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weatherSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/weatherLeft"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_soft"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true" />

                <LinearLayout
                    android:id="@+id/hourly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/weatherSub"
                    android:layout_marginTop="12dp"
                    android:paddingTop="11dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false" />
            </RelativeLayout>
        </RelativeLayout>

        <!-- The mantra of the day. Press OK to play it. -->
        <TextView
            android:id="@+id/quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:paddingTop="7dp"
            android:paddingBottom="9dp"
            android:background="@drawable/quote_bg"
            android:textColor="@color/accent"
            android:textSize="18sp"
            android:singleLine="true"
            android:nextFocusDown="@+id/grid"
            android:nextFocusUp="@+id/btnInputs"
            android:visibility="gone" />

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>
