<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07091C">

    <!-- A soft light that drifts slowly across the background, so the screen is never quite still.
         One view, one translation animation, nothing redrawn: cheap enough for a 1 GB TV. -->
    <View
        android:id="@+id/drift"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="44dp"
        android:paddingEnd="44dp"
        android:paddingTop="22dp">

        <!-- Greeting on the left, the three buttons on the right. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:textColor="#D9FFFFFF"
                android:textSize="19sp"
                android:singleLine="true" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The bento row. Clock and calendar in the left corner, weather in the right, with
             air quality inside the weather pane rather than a tile of its own - on a TV across a
             room a fourth small pane was one too many to read. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:id="@+id/leftTiles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <LinearLayout
                    android:id="@+id/clockTile"
                    android:layout_width="162dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bento_tile"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="true">

                        <TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:format12Hour="h:mm"
                            android:format24Hour="HH:mm"
                            android:textColor="#FFFFFFFF"
                            android:textSize="52sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 300"
                            android:letterSpacing="-0.045"
                            android:includeFontPadding="false" />

                        <TextClock
                            android:id="@+id/ampm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:layout_gravity="bottom"
                            android:layout_marginBottom="8dp"
                            android:format12Hour="a"
                            android:format24Hour=""
                            android:textColor="#FFFFFFFF"
                            android:textSize="21sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.04"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tithi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#A6FFFFFF"
                        android:textSize="13sp"
                        android:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/dateTile"
                    android:layout_width="162dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/bento_tile"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="18dp">

                    <TextClock
                        android:id="@+id/dayName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEEE"
                        android:format24Hour="EEEE"
                        android:textColor="#FFFF2E63"
                        android:textSize="15sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.14"
                        android:textAllCaps="true"
                        android:singleLine="true" />

                    <TextClock
                        android:id="@+id/dayNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:format12Hour="d"
                        android:format24Hour="d"
                        android:textColor="#FFFFFFFF"
                        android:textSize="52sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 300"
                        android:letterSpacing="-0.04"
                        android:includeFontPadding="false"
                        android:singleLine="true" />

                    <TextClock
                        android:id="@+id/monthYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:format12Hour="MMMM yyyy"
                        android:format24Hour="MMMM yyyy"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- weather, right corner, narrow, with air quality in its own column inside -->
            <LinearLayout
                android:id="@+id/weatherTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bento_tile"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="15dp"
                android:paddingBottom="17dp"
                android:visibility="invisible">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/weatherPlace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#8CFFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.12"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/weatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#FFFFFFFF"
                            android:textSize="44sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 300"
                            android:letterSpacing="-0.045"
                            android:includeFontPadding="false"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/weatherSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- air quality, inside the same pane -->
                    <LinearLayout
                        android:id="@+id/airBlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="30dp"
                        android:orientation="vertical"
                        android:visibility="invisible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/aqi_label"
                            android:textColor="#8CFFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:id="@+id/airNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textColor="#FFFF2E63"
                            android:textSize="44sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 300"
                            android:letterSpacing="-0.04"
                            android:includeFontPadding="false"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/airWord"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hourly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:paddingTop="12dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The mantra of the day. Press OK to play it. -->
        <TextView
            android:id="@+id/quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="2dp"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:paddingTop="7dp"
            android:paddingBottom="9dp"
            android:background="@drawable/quote_bg"
            android:textColor="#FFFF2E63"
            android:textSize="18sp"
            android:singleLine="true"
            android:nextFocusDown="@+id/grid"
            android:nextFocusUp="@+id/btnInputs"
            android:visibility="gone" />

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
