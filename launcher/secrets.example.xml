<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE. It lives outside res/values on purpose: two files in there declaring the same names
  would fail the build as duplicate resources. The install scripts copy it to
  launcher/app/src/main/res/values/secrets.xml if that file is missing, so the build always works.
  To fill it in by hand:

      copy launcher\secrets.example.xml launcher\app\src\main\res\values\secrets.xml

  secrets.xml is in .gitignore, so what you type there never reaches GitHub. This template is
  committed and must stay empty.

  Anything here ends up inside the app on your TV. Anyone with ADB access to the TV can read
  it, so use a mailbox and password created only for this, never your personal account.
-->
<resources>

    <!-- Code required by the TV's upload page. Empty means no code: anyone on your Wi-Fi can post.
         Set one if guests know your Wi-Fi password or you just want the extra step. -->
    <string name="upload_pin" translatable="false"></string>

    <!-- Email route. Use a mailbox made only for the TV, and a Gmail APP PASSWORD (16 characters),
         never your real password. mail_allowed_senders is the only list that may post; empty
         means the email route stays off. -->
    <string name="mail_user" translatable="false"></string>
    <string name="mail_password" translatable="false"></string>
    <string name="mail_allowed_senders" translatable="false"></string>

    <!-- Telegram route. Token from @BotFather; chat IDs from: .\windows\tv.ps1 chatid <token>
         Empty token means the Telegram route stays off. -->
    <string name="telegram_bot_token" translatable="false"></string>
    <string name="telegram_allowed_chats" translatable="false"></string>

    <!-- Old public-topic board (ntfy). Leave empty: a topic name is only a secret word, and
         anyone who learns it can read and post. The three routes above replace it. -->
    <string name="message_topic" translatable="false"></string>
</resources>
